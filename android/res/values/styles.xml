<resources>
    <string name="app_name">BlueFish</string>
    <string name="webview_recovery_title">聊天界面暂时无法打开</string>
    <string name="webview_startup_failed">请确认设备上的 Android System WebView 或 Chrome 已启用并更新，然后重试。</string>
    <string name="webview_renderer_stopped">聊天界面意外停止。请重新加载。若反复出现，请更新设备上的 Android System WebView 或 Chrome。</string>
    <string name="webview_retry">重新加载</string>
    <color name="app_surface_light">#FFFFFF</color>
    <color name="app_surface_dark">#1E1F22</color>
    <color name="app_surface">@color/app_surface_light</color>
    <color name="app_ink_light">#181A1E</color>
    <color name="app_ink_dark">#F1F2F4</color>
    <color name="app_accent">#3D63E2</color>
    <bool name="app_light_system_bars">true</bool>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">@bool/app_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/app_light_system_bars</item>
        <item name="android:statusBarColor">@color/app_surface</item>
        <item name="android:navigationBarColor">@color/app_surface</item>
        <item name="android:windowBackground">@color/app_surface</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
